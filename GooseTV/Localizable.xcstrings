    "Lower sits in the black bar under a wide film. Higher clears a soundbar." : {
      "comment" : "Under the subtitle position choices",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefer liegt im schwarzen Balken unter einem Breitbildfilm. Höher bleibt über einer Soundbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más abajo queda en la franja negra bajo una película panorámica. Más arriba libra una barra de sonido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus bas se place dans la bande noire sous un film large. Plus haut dégage une barre de son."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più in basso sta nella banda nera sotto un film panoramico. Più in alto evita una soundbar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「低め」はワイド映像の下の黒帯に収まります。「高め」はサウンドバーを避けます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lager staat in de zwarte balk onder een brede film. Hoger blijft boven een soundbar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais baixo fica na faixa preta sob um filme panorâmico. Mais alto desvia de uma soundbar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“靠下”会落在宽银幕影片下方的黑边里。“靠上”可避开条形音箱。"
          }
        }
      }
    },
