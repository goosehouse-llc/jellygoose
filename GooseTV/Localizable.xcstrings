    "Saved to your %@ account, so your other %@ apps use them too. You can always change tracks during playback." : {
      "comment" : "Both placeholders are the server software's name, Jellyfin or Emby",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In deinem %1$@-Account gespeichert, damit deine anderen %2$@-Apps sie auch nutzen. Spuren kannst du jederzeit während der Wiedergabe ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved to your %1$@ account, so your other %2$@ apps use them too. You can always change tracks during playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guardan en tu cuenta de %1$@, así que tus otras apps de %2$@ también los usan. Siempre puedes cambiar de pista durante la reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrés dans votre compte %1$@, pour que vos autres apps %2$@ les utilisent aussi. Vous pouvez toujours changer de piste pendant la lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvate sul tuo account %1$@, così le usano anche le altre tue app %2$@. Puoi sempre cambiare traccia durante la riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@アカウントに保存されるので、ほかの%2$@アプリでも使われます。再生中はいつでもトラックを変更できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaard in je %1$@-account, zodat je andere %2$@-apps ze ook gebruiken. Je kunt tijdens het afspelen altijd van spoor wisselen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvas na sua conta %1$@, para que seus outros apps %2$@ também as usem. Você pode trocar de faixa durante a reprodução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存储到你的 %1$@ 账户，因此你的其他 %2$@ App 也会使用这些设置。播放期间随时可以更改音轨。"
          }
        }
      }
    },
