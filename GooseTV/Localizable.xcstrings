          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La colección se elimina de tu servidor. Lo que contiene se queda en tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
