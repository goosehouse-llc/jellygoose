    "Requested. It will be in your library once it's ready." : {
      "comment" : "Shown after asking for a title that needs no approval",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angefragt. Sobald es bereit ist, findest du es in deiner Mediathek."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitado. Estará en tu biblioteca en cuanto esté listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandé. Vous le trouverez dans votre bibliothèque dès qu’il sera prêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiesto. Sarà nella tua libreria appena pronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストしました。準備ができるとライブラリに追加されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aangevraagd. Het staat in je bibliotheek zodra het klaar is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitado. Vai aparecer na sua biblioteca assim que estiver pronto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已请求，准备好后会出现在你的资料库中。"
          }
        }
      }
    },
