    "Skip an episode's \"previously on\" and its look at the next one, where your server marks them, or have them skipped for you." : {
      "comment" : "What's New: skipping recaps and previews",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überspringe den „Was bisher geschah“-Teil einer Folge und die Vorschau auf die nächste, wo dein Server sie markiert, oder lass sie automatisch überspringen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta el «Anteriormente» de un episodio y su avance del siguiente, donde tu servidor los marca, o haz que se salten solos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez le « Précédemment » d’un épisode et son aperçu du suivant, là où votre serveur les marque, ou faites-les passer automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salta il «Nelle puntate precedenti» di un episodio e l’anteprima del successivo, dove il tuo server li segna, o falli saltare in automatico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーが印を付けた場所で、エピソードの「前回までのあらすじ」や次回予告を飛ばせます。自動で飛ばすこともできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sla het ‘Eerder in’ van een aflevering en de vooruitblik op de volgende over, waar je server ze markeert, of laat ze automatisch overslaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pule o “Anteriormente” de um episódio e a prévia do próximo, onde seu servidor os marca, ou deixe que sejam pulados sozinhos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在服务器标记的地方，跳过剧集的“前情回顾”和下一集预告，也可以让它们自动跳过。"
          }
        }
      }
    },
