    "Stop after a while, or when the film, episode or programme ends: from the player's buttons, or Live TV's." : {
      "comment" : "What's New: the sleep timer",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stoppt nach einer Weile oder wenn Film, Folge oder Sendung zu Ende ist: über die Tasten im Player oder im Live-TV."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detiene al cabo de un rato o cuando termina la película, el episodio o el programa: desde los botones del reproductor o de la TV en directo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêt au bout d’un moment ou à la fin du film, de l’épisode ou du programme : depuis les boutons du lecteur ou de la TV en direct."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si ferma dopo un po’ o alla fine del film, dell’episodio o del programma: dai pulsanti del player o della TV in diretta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一定時間後、または映画・エピソード・番組の終わりに停止します。プレーヤーやライブTVのボタンから設定できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stopt na een tijdje of als de film, aflevering of het programma afloopt: via de knoppen van de speler of van live-tv."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para depois de um tempo ou quando o filme, episódio ou programa termina: pelos botões do player ou da TV ao vivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一段时间后或在电影、剧集、节目结束时停止：可在播放器或电视直播的按钮中设置。"
          }
        }
      }
    },
