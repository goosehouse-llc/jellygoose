    "It finds people and collections too, and home videos and music videos are libraries now." : {
      "comment" : "What's New: wider search and more library kinds",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie findet auch Personen und Sammlungen, und Heimvideos und Musikvideos sind jetzt Mediatheken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También encuentra personas y colecciones, y los vídeos caseros y musicales ya son bibliotecas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle trouve aussi les personnes et les collections, et les vidéos personnelles et clips musicaux sont désormais des bibliothèques."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trova anche persone e raccolte, e i video personali e musicali ora sono librerie."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人物やコレクションも見つかります。ホームビデオとミュージックビデオもライブラリとして表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het vindt ook personen en collecties, en thuisvideo's en muziekvideo's zijn nu bibliotheken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela também encontra pessoas e coleções, e vídeos caseiros e videoclipes agora são bibliotecas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在还能找到人物和合集，家庭视频和音乐视频也成为资料库。"
          }
        }
      }
    },
    "It stays on your server; only the copy on this device goes." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem Server bleibt es; nur die Kopie auf diesem Gerät wird entfernt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguirá en tu servidor; solo se elimina la copia de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il reste sur votre serveur ; seule la copie sur cet appareil est supprimée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta sul tuo server; viene rimossa solo la copia su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバには残ります。削除されるのはこのデバイスのコピーだけです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het blijft op je server; alleen de kopie op dit apparaat verdwijnt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continua no seu servidor; só a cópia neste dispositivo é removida."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
