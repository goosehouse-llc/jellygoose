    },
    "Lets a phone or tablet signed in to your account play films here, and pause, move through or stop them. They list this Apple TV by the name beside the switch." : {
      "comment" : "Settings, Playback, on the Apple TV: under Play on TV",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaubt einem Telefon oder Tablet, das mit deinem Konto angemeldet ist, hier Filme abzuspielen und sie anzuhalten, zu spulen oder zu stoppen. Sie führen dieses Apple TV unter dem Namen neben dem Schalter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que un teléfono o tableta con tu cuenta reproduzca películas aquí y las pause, avance o detenga. Muestran este Apple TV con el nombre que hay junto al interruptor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet à un téléphone ou une tablette connecté à votre compte de lire des films ici, et de les mettre en pause, de s’y déplacer ou de les arrêter. Ils affichent cette Apple TV sous le nom indiqué à côté de l’interrupteur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente a un telefono o tablet collegato al tuo account di riprodurre film qui, e di metterli in pausa, spostarsi o fermarli. Elencano questa Apple TV con il nome accanto all’interruttore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じアカウントでサインインしたiPhoneやiPadから、ここで映画を再生し、一時停止、移動、停止できるようにします。このApple TVは、スイッチの横の名前で一覧に表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat een telefoon of tablet die met je account is ingelogd hier films afspelen, en ze pauzeren, verspringen of stoppen. Ze tonen deze Apple TV met de naam naast de schakelaar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite que um celular ou tablet conectado à sua conta reproduza filmes aqui e os pause, avance ou pare. Eles listam esta Apple TV pelo nome ao lado do botão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许登录你账户的手机或平板在这里播放电影，并暂停、跳转或停止。它们会以开关旁的名称列出这台 Apple TV。"
          }
        }
      }
    },
