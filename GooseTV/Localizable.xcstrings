    "Nothing after this song." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach diesem Song kommt nichts mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada después de esta canción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien après ce morceau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente dopo questo brano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この曲の後には何もありません。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na dit nummer komt er niets meer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada depois desta música."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这首歌之后没有其他歌曲。"
          }
        }
      }
    },
    "Nothing coming up. The server lists the episodes still to air of shows it has, where its information about them says when." : {
      "comment" : "Coming Soon, with nothing in it",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nichts in Sicht. Der Server zeigt noch nicht ausgestrahlte Folgen seiner Serien, sofern seine Daten dazu ein Datum nennen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay nada próximamente. El servidor muestra los episodios aún por emitir de las series que tiene, cuando su información indica la fecha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien à venir. Le serveur indique les épisodes pas encore diffusés de ses séries, quand ses informations en donnent la date."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niente in arrivo. Il server elenca gli episodi ancora da trasmettere delle serie che ha, quando le sue informazioni ne indicano la data."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近日公開の予定はありません。サーバーは、所有する番組のうち放送日が分かっている未放送のエピソードを表示します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Niets op komst. De server toont nog niet uitgezonden afleveringen van zijn series, als zijn gegevens zeggen wanneer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada por vir. O servidor lista os episódios ainda não exibidos das séries que tem, quando as informações dele dizem a data."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂无即将播出的内容。服务器会列出其剧集中尚未播出、且资料中注明播出日期的单集。"
          }
        }
      }
    },
    "Nothing downloaded yet. Download a film or an episode from its page or by right-clicking it, or a whole season by right-clicking one of its episodes, to watch it without your server." : {
      "comment" : "Downloads page on a Mac, when there are none: how to download. A right click opens a title's menu there",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts geladen. Lade einen Film oder eine Folge auf der jeweiligen Seite oder per Rechtsklick darauf, oder eine ganze Staffel per Rechtsklick auf eine ihrer Folgen, um sie ohne deinen Server anzusehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no has descargado nada. Descarga una película o un episodio desde su página o haciendo clic derecho en él, o una temporada entera haciendo clic derecho en uno de sus episodios, para verlos sin tu servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est encore téléchargé. Téléchargez un film ou un épisode depuis sa page ou d’un clic droit dessus, ou une saison entière d’un clic droit sur l’un de ses épisodes, pour les regarder sans votre serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai ancora scaricato nulla. Scarica un film o un episodio dalla sua pagina o facendo clic destro su di esso, oppure un’intera stagione facendo clic destro su uno dei suoi episodi, per guardarli senza il tuo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ何もダウンロードしていません。映画やエピソードはそのページか右クリックで、シーズン全体はそのシーズンのエピソードを右クリックしてダウンロードすると、サーバなしで観られます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niets gedownload. Download een film of aflevering vanaf de pagina ervan of door erop te rechtsklikken, of een heel seizoen door op een van de afleveringen te rechtsklikken, om zonder je server te kijken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada baixado ainda. Baixe um filme ou um episódio na página dele ou clicando nele com o botão direito, ou uma temporada inteira clicando com o botão direito em um dos episódios, para assistir sem o seu servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有下载任何内容。在影片或剧集的页面下载，或右键点按它从菜单中下载；右键点按某一集，可下载整季。下载后即可在没有服务器时观看。"
          }
        }
      }
    },
    "Nothing downloaded yet. Download a film or an episode from its page or its long-press menu, or a whole season from an episode's long-press menu, to watch it without your server." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts geladen. Lade einen Film oder eine Folge auf der jeweiligen Seite oder über das Menü, das beim Gedrückthalten erscheint, oder eine ganze Staffel über das Menü einer ihrer Folgen, um sie ohne deinen Server anzusehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no has descargado nada. Descarga una película o un episodio desde su página o desde el menú que aparece al mantenerlo pulsado, o una temporada entera desde el menú de uno de sus episodios, para verlos sin tu servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’est encore téléchargé. Téléchargez un film ou un épisode depuis sa page ou son menu (appui prolongé), ou une saison entière depuis le menu d’un de ses épisodes, pour les regarder sans votre serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai ancora scaricato nulla. Scarica un film o un episodio dalla sua pagina o dal menu che si apre tenendolo premuto, oppure un’intera stagione dal menu di uno dei suoi episodi, per guardarli senza il tuo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ何もダウンロードしていません。映画やエピソードはそのページか長押しして出るメニューから、シーズン全体はそのシーズンのエピソードを長押しして出るメニューからダウンロードすると、サーバなしで観られます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog niets gedownload. Download een film of aflevering vanaf de pagina ervan of via het menu dat je krijgt als je hem ingedrukt houdt, of een heel seizoen via het menu van een van de afleveringen, om zonder je server te kijken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada baixado ainda. Baixe um filme ou um episódio na página dele ou no menu que aparece ao tocar e segurar, ou uma temporada inteira no menu de um dos episódios, para assistir sem o seu servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还没有下载任何内容。在影片或剧集的页面下载，或长按它从菜单中下载；长按某一集，可从菜单中下载整季。下载后即可在没有服务器时观看。"
          }
        }
      }
    },
