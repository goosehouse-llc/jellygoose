    "No audiobooks here. Books on your server that are sound, not pages, show up here." : {
      "comment" : "A library of books with no audiobooks in it",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier gibt es keine Hörbücher. Bücher auf deinem Server, die man hört statt liest, erscheinen hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay audiolibros. Los libros de tu servidor que se escuchan, en vez de leerse, aparecen aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun livre audio ici. Les livres de votre serveur qui s’écoutent plutôt qu’ils ne se lisent apparaissent ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun audiolibro qui. I libri sul tuo server da ascoltare, non da leggere, compaiono qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここにはオーディオブックがありません。サーバー上の、読むのではなく聴く本がここに表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geen luisterboeken hier. Boeken op je server om te beluisteren, niet om te lezen, verschijnen hier."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum audiolivro aqui. Os livros do seu servidor que são para ouvir, não para ler, aparecem aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这里没有有声书。服务器上用来听而不是读的书会显示在这里。"
          }
        }
      }
    },
