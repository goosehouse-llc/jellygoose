    "Each recording on its own card, with the day it aired and the programme's picture, and new ones there as soon as you look." : {
      "comment" : "What's New: the recordings library's changes",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jede Aufnahme auf ihrer eigenen Karte, mit dem Sendetag und dem Bild der Sendung, und neue sind da, sobald du nachsiehst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada grabación en su propia tarjeta, con el día en que se emitió y la imagen del programa, y las nuevas aparecen en cuanto miras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque enregistrement sur sa propre carte, avec le jour de diffusion et l’image du programme, et les nouveaux sont là dès que vous regardez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni registrazione sulla sua scheda, con il giorno di trasmissione e l’immagine del programma, e quelle nuove ci sono appena guardi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録画ごとに専用のカードを表示し、放送日と番組の画像付きで、新しい録画も開いたときにすぐ表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke opname op een eigen kaart, met de dag van uitzending en het beeld van het programma, en nieuwe staan er zodra je kijkt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada gravação no seu próprio cartão, com o dia em que foi exibida e a imagem do programa, e as novas aparecem assim que você olha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个录像都有自己的卡片，带有播出日期和节目图片，新的录像一打开就能看到。"
          }
        }
      }
    },
