    "Requests wears colours of its own, so it doesn't look like your library." : {
      "comment" : "Explains the setting for the Requests section's colour scheme",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anfragen hat eigene Farben, damit es nicht wie deine Mediathek aussieht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitudes tiene sus propios colores, para que no se confunda con tu biblioteca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandes a ses propres couleurs, pour ne pas ressembler à votre bibliothèque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richieste ha colori propri, così non si confonde con la tua libreria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストは独自の配色で表示され、ライブラリと見分けがつきます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzoeken heeft eigen kleuren, zodat het niet op je bibliotheek lijkt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitações tem cores próprias, para não se confundir com a sua biblioteca."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“请求”使用独立的配色，以便与资料库区分开来。"
          }
        }
      }
    },
