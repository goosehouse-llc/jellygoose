    "Your server makes a smaller copy of anything bigger, about %@ an hour. A change applies to downloads started after it." : {
      "comment" : "Downloads page, under Download Quality. The placeholder is a size, like 1.4 GB",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Server erstellt von allem, was größer ist, eine kleinere Kopie, etwa %@ pro Stunde. Eine Änderung gilt für Downloads, die danach beginnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu servidor hace una copia más pequeña de lo que sea más grande, unos %@ por hora. Un cambio se aplica a las descargas que empiecen después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre serveur crée une copie plus petite de ce qui est plus volumineux, environ %@ par heure. Une modification s’applique aux téléchargements lancés ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo server crea una copia più piccola di ciò che è più grande, circa %@ all’ora. Una modifica vale per i download avviati dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これより大きいものは、サーバーが小さいコピーを作成します（1時間あたり約%@）。変更は、その後に始めたダウンロードに適用されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je server maakt van alles wat groter is een kleinere kopie, ongeveer %@ per uur. Een wijziging geldt voor downloads die daarna beginnen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu servidor faz uma cópia menor de tudo o que for maior, cerca de %@ por hora. Uma mudança vale para os downloads iniciados depois."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器会为更大的内容制作较小的副本，约每小时 %@。更改仅适用于之后开始的下载。"
          }
        }
      }
    },
    "Your server's albums, artists and playlists, with lyrics and Up Next, playing on in the background and in the car with CarPlay." : {
      "comment" : "What's New: music libraries, on the iPhone and iPad",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alben, Künstler und Playlists deines Servers, mit Songtexten und „Als Nächstes“ – auch im Hintergrund und mit CarPlay im Auto."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los álbumes, artistas y listas de tu servidor, con letras y «A continuación», también en segundo plano y en el coche con CarPlay."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les albums, artistes et listes de lecture de votre serveur, avec les paroles et « À suivre », en arrière-plan comme en voiture avec CarPlay."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album, artisti e playlist del tuo server, con testi e «Successivi», anche in background e in auto con CarPlay."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーのアルバム、アーティスト、プレイリストを、歌詞や「次に再生」とともに。バックグラウンドでも、CarPlayで車の中でも再生できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De albums, artiesten en afspeellijsten van je server, met songteksten en ‘Hierna’, ook op de achtergrond en in de auto met CarPlay."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os álbuns, artistas e playlists do seu servidor, com letras e “A seguir”, tocando em segundo plano e no carro com o CarPlay."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
