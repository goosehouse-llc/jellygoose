          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt een artiest, album, afspeellijst of nummer af in JellyGoose."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz um artista, um álbum, uma playlist ou uma música no JellyGoose."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 JellyGoose 中播放艺人、专辑、播放列表或歌曲。"
          }
        }
      }
    },
    "Plays files as they are when the Apple TV supports them. Turn off to always stream a transcode instead." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt Dateien unverändert ab, wenn Apple TV sie unterstützt. Ausschalten, um immer transkodiert zu streamen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce los archivos tal cual cuando el Apple TV es compatible con ellos. Desactívalo para transmitir siempre una versión transcodificada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit les fichiers tels quels quand l’Apple TV les prend en charge. Désactivez pour toujours diffuser une version transcodée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce i file così come sono quando Apple TV li supporta. Disattiva per ricevere sempre uno stream transcodificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TVが対応しているファイルはそのまま再生します。オフにすると常にトランスコードしてストリーミングします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt bestanden ongewijzigd af als de Apple TV ze ondersteunt. Zet uit om altijd getranscodeerd te streamen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz os arquivos como estão quando a Apple TV é compatível. Desative para sempre receber um stream transcodificado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple TV 支持的文件将按原样播放。关闭后将始终以转码方式串流。"
          }
        }
      }
    },
    "Plays files as they are when this device supports them. Turn off to always stream a transcode instead." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
