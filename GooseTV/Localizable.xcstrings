    "Nothing has arrived for a while. This file may be damaged, or the server may have stopped sending. Press back to leave." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit einer Weile kommt nichts mehr an. Die Datei ist vielleicht beschädigt oder der Server sendet nicht mehr. Drück „Zurück“ zum Verlassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No llega nada desde hace un rato. Puede que el archivo esté dañado o que el servidor haya dejado de enviarlo. Pulsa Atrás para salir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus rien n’arrive depuis un moment. Le fichier est peut-être endommagé, ou le serveur a cessé l’envoi. Appuyez sur Retour pour quitter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non arriva nulla da un po'. Il file potrebbe essere danneggiato o il server potrebbe aver smesso di inviarlo. Premi Indietro per uscire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "しばらくデータが届いていません。ファイルが破損しているか、サーバが送信を停止した可能性があります。戻るを押して終了してください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er komt al een tijdje niets binnen. Het bestand is misschien beschadigd, of de server stuurt niets meer. Druk op terug om te stoppen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada chegou há algum tempo. O arquivo pode estar danificado ou o servidor pode ter parado de enviar. Pressione Voltar para sair."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已有一段时间未收到数据。此文件可能已损坏，或者服务器可能已停止发送。按返回键离开。"
          }
        }
      }
    },
