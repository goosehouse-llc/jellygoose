    "Start a group or join one from the menu, then play something: it plays for everyone in step, each on their own screen." : {
      "comment" : "What's New: Watch Together",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starte im Menü eine Gruppe oder tritt einer bei und spiele dann etwas ab: Es läuft bei allen synchron, jeweils auf dem eigenen Bildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un grupo o únete a uno desde el menú y reproduce algo: se ve a la vez para todos, cada uno en su pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créez un groupe ou rejoignez-en un depuis le menu, puis lancez quelque chose : la lecture est synchronisée pour tous, chacun sur son écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crea un gruppo o unisciti a uno dal menu, poi riproduci qualcosa: parte in sincrono per tutti, ognuno sul proprio schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューからグループを作成または参加して再生すると、全員の画面で同時に再生されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start een groep of word lid via het menu en speel iets af: het speelt voor iedereen gelijk, ieder op een eigen scherm."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crie um grupo ou entre em um pelo menu e reproduza algo: toca em sincronia para todos, cada um na sua tela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从菜单创建或加入群组，然后播放内容：每个人在自己的屏幕上同步观看。"
          }
        }
      }
    },
