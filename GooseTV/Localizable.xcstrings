    "Continue Watching and Next Up on your Home Screen and Lock Screen, and a download's progress there as it comes in." : {
      "comment" : "What's New: widgets and the downloads Live Activity",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Weiterschauen“ und „Als Nächstes“ auf deinem Home-Bildschirm und Sperrbildschirm, dazu der Fortschritt laufender Downloads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Seguir viendo» y «A continuación» en tu pantalla de inicio y de bloqueo, y el progreso de las descargas mientras llegan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Reprendre la lecture » et « À suivre » sur votre écran d’accueil et votre écran verrouillé, avec la progression des téléchargements en cours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Continua a guardare» e «A seguire» nella schermata Home e nella schermata di blocco, con l’avanzamento dei download in corso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホーム画面とロック画面に「続きを観る」と「次に観る」を。ダウンロードの進み具合もそこに表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Verder kijken’ en ‘Hierna’ op je beginscherm en toegangsscherm, en de voortgang van downloads terwijl ze binnenkomen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Continuar Assistindo” e “A Seguir” na Tela de Início e na Tela Bloqueada, além do progresso dos downloads enquanto chegam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在主屏幕和锁定屏幕上显示“继续观看”和“待播清单”，下载进度也会实时显示在那里。"
          }
        }
      }
    },
