    "The most this Apple TV will stream. Lower it if playback stutters; the server transcodes anything above it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Maximum, das dieses Apple TV streamt. Senke es, wenn die Wiedergabe ruckelt; alles darüber transkodiert der Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El máximo que transmitirá este Apple TV. Bájalo si la reproducción se entrecorta; el servidor transcodifica todo lo que lo supere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le maximum que cette Apple TV diffusera. Baissez-le si la lecture saccade ; le serveur transcode tout ce qui le dépasse."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il massimo che questa Apple TV riceverà in streaming. Abbassalo se la riproduzione scatta; il server transcodifica tutto ciò che lo supera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このApple TVでストリーミングする上限です。再生が途切れる場合は下げてください。これを超えるものはサーバがトランスコードします。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het maximum dat deze Apple TV streamt. Verlaag het als het afspelen hapert; de server transcodeert alles daarboven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O máximo que esta Apple TV vai transmitir. Diminua se a reprodução travar; o servidor transcodifica o que passar disso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Apple TV 串流的上限。如果播放卡顿，请调低；超过上限的内容将由服务器转码。"
          }
        }
      }
    },
