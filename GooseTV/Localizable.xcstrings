    "Have your server make a smaller copy as it downloads, so a whole season fits." : {
      "comment" : "What's New: smaller downloads",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass deinen Server beim Laden eine kleinere Kopie erstellen, damit eine ganze Staffel passt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz que tu servidor cree una copia más pequeña al descargar, para que quepa una temporada entera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites créer par votre serveur une copie plus petite pendant le téléchargement, pour qu’une saison entière tienne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai creare al server una copia più piccola durante il download, così ci sta un’intera stagione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード時にサーバーが小さいコピーを作るので、シーズン全体が収まります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laat je server tijdens het downloaden een kleinere kopie maken, zodat een heel seizoen past."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faça seu servidor criar uma cópia menor ao baixar, para caber uma temporada inteira."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "让服务器在下载时制作较小的副本，整季都能装下。"
          }
        }
      }
    },
