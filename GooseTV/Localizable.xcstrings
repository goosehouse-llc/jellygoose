    },
    "Left and right go back and on through the channel you're watching, and Play/Pause holds it. Up to half an hour is kept, on this Apple TV." : {
      "comment" : "What's New: pausing and rewinding a television channel, with the Apple TV's remote",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links und rechts gehen im laufenden Sender zurück und vor, Wiedergabe/Pause hält ihn an. Bis zu eine halbe Stunde wird auf diesem Apple TV gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izquierda y derecha retroceden y avanzan en el canal que estás viendo, y Reproducir/Pausa lo detiene. Se guarda hasta media hora, en este Apple TV."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gauche et droite reviennent en arrière et avancent dans la chaîne que vous regardez, et Lecture/Pause la met en pause. Jusqu’à une demi-heure est gardée, sur cet Apple TV."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinistra e destra tornano indietro e avanzano nel canale che stai guardando, e Riproduci/Pausa lo ferma. Viene conservata fino a mezz’ora, su questa Apple TV."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "左右で視聴中のチャンネルを戻したり進めたりでき、再生/一時停止で止められます。最大30分までこのApple TVに保存されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links en rechts gaan terug en vooruit in de zender die je kijkt, en Speel/Pauze zet hem stil. Tot een half uur wordt bewaard, op deze Apple TV."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esquerda e direita voltam e avançam no canal que você está assistindo, e Reproduzir/Pausar o segura. Até meia hora fica guardada, neste Apple TV."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按左右键可在正在观看的频道中后退和前进，按播放/暂停键可暂停。最多保存半小时，保存在这台 Apple TV 上。"
          }
        }
      }
    },
