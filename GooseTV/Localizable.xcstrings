    "Soft sage green over deep green-grey, like a forest in the mist." : {
      "comment" : "Description of the Evergreen colour scheme",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sanftes Salbeigrün über tiefem Graugrün, wie ein Wald im Nebel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde salvia suave sobre un verde grisáceo profundo, como un bosque entre la niebla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un vert sauge doux sur un vert-gris profond, comme une forêt dans la brume."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verde salvia tenue su un grigio-verde profondo, come un bosco nella nebbia."
