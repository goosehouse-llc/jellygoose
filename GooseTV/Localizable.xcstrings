    "Books from your server, chapter by chapter, at the speed you like, and picked up where you left off." : {
      "comment" : "What's New: audiobooks",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bücher von deinem Server, Kapitel für Kapitel, in deinem Tempo, und genau dort fortgesetzt, wo du aufgehört hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los libros de tu servidor, capítulo a capítulo, a la velocidad que quieras, y retomados donde los dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les livres de votre serveur, chapitre par chapitre, à la vitesse de votre choix, repris là où vous vous étiez arrêté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I libri del tuo server, capitolo per capitolo, alla velocità che preferisci, ripresi da dove li avevi lasciati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーのオーディオブックを、章ごとに、好きな速度で。途中でやめても続きから再生できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boeken van je server, hoofdstuk voor hoofdstuk, op de snelheid die jij wilt, en verder waar je was gebleven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os livros do seu servidor, capítulo por capítulo, na velocidade que você preferir, retomados de onde você parou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "服务器上的有声书，按章节收听，速度随心调节，并从上次停下的地方继续。"
          }
        }
      }
    },
