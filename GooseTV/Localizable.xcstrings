          }
        }
      }
    },
    "The icon in the Dock while JellyGoose is open. It changes as soon as you pick one; Finder and Launchpad keep the usual one." : {
      "comment" : "Settings, Appearance, on a Mac: what the app icon choice changes",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Symbol im Dock, solange JellyGoose geöffnet ist. Es ändert sich sofort, wenn du eines wählst; Finder und Launchpad behalten das übliche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El icono del Dock mientras JellyGoose está abierta. Cambia en cuanto eliges uno; Finder y Launchpad mantienen el habitual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'icône dans le Dock tant que JellyGoose est ouverte. Elle change dès que vous en choisissez une ; le Finder et Launchpad gardent l'icône habituelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'icona nel Dock mentre JellyGoose è aperta. Cambia appena ne scegli una; Finder e Launchpad mantengono quella solita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JellyGoose を開いている間の Dock のアイコンです。選ぶとすぐに変わります。Finder と Launchpad はいつものアイコンのままです。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het symbool in het Dock zolang JellyGoose open is. Het verandert zodra je er een kiest; Finder en Launchpad houden het gewone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ícone no Dock enquanto o JellyGoose está aberto. Ele muda assim que você escolhe um; o Finder e o Launchpad mantêm o de sempre."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JellyGoose 打开时程序坞中的图标。选好后立即更改；访达和启动台保持原来的图标。"
