    "A notification when a new episode of a show you watch arrives. Turn it on in Settings, Playback." : {
      "comment" : "What's New: new-episode alerts",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Mitteilung, wenn eine neue Folge einer Serie ankommt, die du schaust. Schalte sie unter Einstellungen > Wiedergabe ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notificación cuando llega un episodio nuevo de una serie que ves. Actívalo en Ajustes > Reproducción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une notification quand arrive un nouvel épisode d’une série que vous regardez. À activer dans Réglages > Lecture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una notifica quando arriva un nuovo episodio di una serie che guardi. Attivala in Impostazioni > Riproduzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴中の番組に新しいエピソードが届くと通知します。設定の「再生」でオンにできます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een melding wanneer er een nieuwe aflevering van een serie die je kijkt binnenkomt. Zet het aan in Instellingen > Afspelen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma notificação quando chega um novo episódio de uma série que você assiste. Ative em Ajustes > Reprodução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在看的剧集有新一集时发送通知。可在“设置 > 播放”中打开。"
