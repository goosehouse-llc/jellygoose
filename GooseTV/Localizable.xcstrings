    "Pick up where you left off, play a film or a show, or shuffle your music, from Siri or the Shortcuts app." : {
      "comment" : "What's New: actions for Siri and the Shortcuts app",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mach dort weiter, wo du aufgehört hast, spiel einen Film oder eine Serie ab oder misch deine Musik – mit Siri oder der Kurzbefehle-App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retoma lo que dejaste a medias, reproduce una película o una serie, o mezcla tu música, con Siri o la app Atajos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprenez là où vous vous étiez arrêté, lancez un film ou une série, ou écoutez votre musique en aléatoire, avec Siri ou l’app Raccourcis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riprendi da dove avevi lasciato, avvia un film o una serie, o ascolta la tua musica in ordine casuale, con Siri o l’app Comandi rapidi."
