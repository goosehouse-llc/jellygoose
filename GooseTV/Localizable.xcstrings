    "Sort either way round, choose several genres or decades, and each library remembers how you left it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortiere in beide Richtungen, wähle mehrere Genres oder Jahrzehnte, und jede Mediathek merkt sich, wie du sie verlassen hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordena en cualquier sentido, elige varios géneros o décadas, y cada biblioteca recuerda cómo la dejaste."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triez dans un sens ou dans l’autre, choisissez plusieurs genres ou décennies, et chaque bibliothèque se souvient de vos réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordina in entrambi i sensi, scegli più generi o decenni, e ogni libreria ricorda come l’hai lasciata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "昇順・降順の並べ替えや、複数のジャンルや年代の選択に対応。各ライブラリは前回の設定を覚えています。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sorteer in beide richtingen, kies meerdere genres of decennia, en elke bibliotheek onthoudt hoe je hem achterliet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordene nos dois sentidos, escolha vários gêneros ou décadas, e cada biblioteca lembra como você a deixou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可正序或倒序排列，可同时选择多个类型或年代，每个资料库都会记住你上次的设置。"
          }
        }
      }
    },
