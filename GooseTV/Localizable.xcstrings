    "The channel stopped coming. Choose it again to retry." : {
      "comment" : "Live TV: the channel's stream broke off or never showed a picture",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sender kommt nicht mehr an. Wähle ihn erneut, um es noch einmal zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El canal ha dejado de llegar. Elígelo otra vez para reintentar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chaîne ne passe plus. Choisissez-la à nouveau pour réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il canale non arriva più. Sceglilo di nuovo per riprovare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チャンネルの受信が止まりました。もう一度選ぶと再試行します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
