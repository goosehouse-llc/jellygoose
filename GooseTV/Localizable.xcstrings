    "The next episodes you haven't watched are kept on this device, and the ones it downloaded are deleted once watched." : {
      "comment" : "Under the shows kept downloaded: what keeping one does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nächsten Folgen, die du noch nicht gesehen hast, bleiben auf diesem Gerät, und die so geladenen werden gelöscht, sobald du sie gesehen hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los siguientes episodios que no has visto se guardan en este dispositivo, y los que se descargaron así se eliminan una vez vistos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les prochains épisodes que vous n’avez pas vus sont gardés sur cet appareil, et ceux téléchargés ainsi sont supprimés une fois vus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I prossimi episodi che non hai visto restano su questo dispositivo, e quelli scaricati così vengono eliminati una volta visti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ観ていない次のエピソードをこのデバイスに保存し、こうしてダウンロードしたものは観終わると削除します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De volgende afleveringen die je nog niet gezien hebt, blijven op dit apparaat, en de zo gedownloade worden verwijderd zodra je ze gezien hebt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os próximos episódios que você não assistiu ficam neste dispositivo, e os baixados assim são apagados depois de assistidos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未观看的后续单集会保存在此设备上，以此方式下载的单集在看完后会被删除。"
          }
        }
      }
    },
