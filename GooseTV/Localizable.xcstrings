    "Shrink a film to a small window and keep browsing. Turn the device on its side to fill the screen again." : {
      "comment" : "What's New: Picture in Picture for films",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkleinere einen Film auf ein kleines Fenster und stöbere weiter. Drehe das Gerät quer, und er füllt wieder den Bildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduce una película a una ventana pequeña y sigue explorando. Gira el dispositivo y vuelve a llenar la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réduisez un film à une petite fenêtre et continuez à parcourir. Tournez l’appareil pour qu’il remplisse de nouveau l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riduci un film a una piccola finestra e continua a sfogliare. Ruota il dispositivo e torna a tutto schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映画を小さなウインドウにして、そのままブラウズを続けられます。デバイスを横向きにすると全画面に戻ります。"
