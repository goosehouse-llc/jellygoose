    "Mark films to watch later, from a film's page or a long press. Watching one takes it off." : {
      "comment" : "What's New: the film watchlist",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merke Filme für später vor, auf der Filmseite oder per langem Druck. Angesehene verschwinden von der Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marca películas para ver más tarde, desde su página o con una pulsación larga. Al verla, sale de la lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marquez des films à voir plus tard, depuis leur page ou par un appui long. Un film regardé quitte la liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segna i film da vedere più tardi, dalla pagina del film o con una pressione prolungata. Una volta visto, esce dalla lista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映画のページや長押しから、あとで見る映画を登録できます。視聴するとリストから外れます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markeer films om later te kijken, op de filmpagina of met lang indrukken. Na het kijken verdwijnt de film van de lijst."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Marque filmes para ver depois, na página do filme ou com um toque longo. Ao assistir, ele sai da lista."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可在电影页面或通过长按标记稍后观看的电影。看完后会自动从列表移除。"
          }
        }
      }
    },
