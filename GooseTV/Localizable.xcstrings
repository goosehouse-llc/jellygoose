    "MKV films play straight from the file, keeping Dolby Vision and Atmos, and every film is set up while you read its page." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MKV-Filme werden direkt aus der Datei abgespielt, mit Dolby Vision und Atmos, und jeder Film wird vorbereitet, während du seine Seite liest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las películas MKV se reproducen directamente desde el archivo, con Dolby Vision y Atmos, y cada película se prepara mientras lees su página."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les films MKV sont lus directement depuis le fichier, en conservant Dolby Vision et Atmos, et chaque film se prépare pendant que vous lisez sa page."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I film MKV vengono riprodotti direttamente dal file, con Dolby Vision e Atmos, e ogni film si prepara mentre leggi la sua pagina."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MKVの映画はファイルから直接再生され、Dolby VisionとAtmosもそのまま。作品ページを見ている間に再生の準備も整います。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MKV-films worden rechtstreeks uit het bestand afgespeeld, met Dolby Vision en Atmos, en elke film wordt klaargezet terwijl je zijn pagina leest."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filmes MKV são reproduzidos direto do arquivo, mantendo Dolby Vision e Atmos, e cada filme é preparado enquanto você lê a página dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MKV 影片直接从文件播放，保留杜比视界和全景声；在你浏览影片页面时，影片就已准备好。"
          }
        }
      }
    },
