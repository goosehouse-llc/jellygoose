    "Pure black with steel and silver. Easiest on an OLED." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reines Schwarz mit Stahl und Silber. Am schonendsten für OLED."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negro puro con acero y plata. Ideal para pantallas OLED."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noir pur avec acier et argent. Idéal sur un écran OLED."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nero puro con acciaio e argento. Il più adatto agli OLED."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "純粋な黒にスチールとシルバー。OLEDに最もやさしい配色です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puur zwart met staal en zilver. Het vriendelijkst voor een OLED."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preto puro com aço e prata. O melhor para OLED."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "纯黑搭配钢灰和银色。最适合 OLED 屏幕。"
          }
        }
      }
    },
    "Put Home's rows in the order you like, or switch one off: Settings, Home Screen." : {
      "comment" : "What's New: Home's rows can be reordered and hidden",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring die Reihen von Home in deine Reihenfolge oder schalte eine aus: Einstellungen, Home-Bildschirm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordena las filas de Inicio a tu gusto o desactiva alguna: Ajustes, Pantalla de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez les rangées de l’accueil dans l’ordre qui vous plaît, ou désactivez-en une : Réglages, Écran d’accueil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti le righe della Home nell’ordine che preferisci, o disattivane una: Impostazioni, Schermata Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホームの列を好きな順に並べ替えたり、非表示にしたりできます（設定 › ホーム画面）。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet de rijen van Home in de volgorde die jij wilt, of zet er een uit: Instellingen, Home-scherm."
          }
        },
        "pt-BR" : {
