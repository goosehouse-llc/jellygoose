    "Hold a channel, or go back through it, with the buttons over the picture. Up to half an hour is kept, on this device." : {
      "comment" : "What's New: pausing and rewinding a television channel, by touch",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte einen Sender an oder geh darin zurück, mit den Tasten über dem Bild. Bis zu eine halbe Stunde wird auf diesem Gerät gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa un canal o retrocede en él con los botones sobre la imagen. Se guarda hasta media hora, en este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez une chaîne en pause ou revenez en arrière avec les boutons sur l’image. Jusqu’à une demi-heure est gardée, sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti in pausa un canale o torna indietro con i pulsanti sull’immagine. Viene conservata fino a mezz’ora, su questo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映像の上のボタンで、チャンネルを一時停止したり巻き戻したりできます。最大30分までこのデバイスに保存されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet een zender stil of ga erin terug met de knoppen over het beeld. Tot een half uur wordt bewaard, op dit apparaat."
          }
