    "Grey is easier on the eyes in a dark room." : {
      "comment" : "Under the subtitle colour choices",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grau ist in einem dunklen Raum angenehmer für die Augen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El gris cansa menos la vista en una habitación a oscuras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le gris est plus reposant pour les yeux dans une pièce sombre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il grigio affatica meno gli occhi in una stanza buia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暗い部屋ではグレーが目にやさしくなります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grijs is rustiger voor de ogen in een donkere kamer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cinza cansa menos os olhos em um ambiente escuro."
          }
