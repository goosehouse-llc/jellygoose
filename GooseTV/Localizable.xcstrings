    "Choose an episode's audio or subtitles once, and the show's other episodes use them too." : {
      "comment" : "What's New: the tracks chosen in an episode are used for the rest of the show",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Ton oder Untertitel einer Episode einmal aus, und die anderen Episoden der Serie übernehmen sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una vez el audio o los subtítulos de un episodio y los demás episodios de la serie los usarán también."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une fois l’audio ou les sous-titres d’un épisode, et les autres épisodes de la série les reprennent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli una volta l’audio o i sottotitoli di un episodio e gli altri episodi della serie li useranno anche loro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エピソードで音声や字幕を一度選べば、その番組のほかのエピソードにも使われます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies één keer de audio of ondertiteling van een aflevering, en de andere afleveringen van de serie gebruiken die ook."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha uma vez o áudio ou as legendas de um episódio, e os outros episódios da série usam os mesmos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只需为一集选择一次音频或字幕，该剧集的其他各集也会沿用。"
          }
        }
      }
    },
    "Choose on your car's screen and hear it as you drive. In a car that shows video, watch it there while you're parked." : {
      "comment" : "What's New: CarPlay, on the iPhone",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle auf dem Bildschirm im Auto und hör es während der Fahrt. In einem Auto, das Video zeigt, schaust du es dort, während es parkt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige en la pantalla del coche y escúchalo mientras conduces. En un coche que muestra vídeo, míralo ahí con el coche aparcado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez sur l’écran de la voiture et écoutez en roulant. Dans une voiture qui affiche la vidéo, regardez sur cet écran à l’arrêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli sullo schermo dell’auto e ascolta mentre guidi. In un’auto che mostra video, guarda lì ad auto ferma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "車の画面で選んで、走行中は音声で楽しめます。映像に対応した車では、駐車中にその画面で視聴できます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies op het scherm van de auto en luister tijdens het rijden. In een auto die video toont, kijk je daar als hij stilstaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha na tela do carro e ouça enquanto dirige. Em um carro que mostra vídeo, assista nela com ele estacionado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在车载屏幕上选择，行驶时收听声音。在支持视频的车上，停车时可在车载屏幕上观看。"
          }
        }
      }
    },
