    "Seerr wouldn't sign this account in. It has to be connected to the same media server, with Quick Connect turned on there." : {
      "comment" : "Shown when Seerr refuses to sign the viewer in with their media server account",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr hat dieses Konto nicht angemeldet. Es muss mit demselben Medienserver verbunden sein, und dort muss Quick Connect aktiviert sein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr no ha querido iniciar sesión con esta cuenta. Tiene que estar conectado al mismo servidor multimedia, con Quick Connect activado en él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr n’a pas voulu connecter ce compte. Il doit être relié au même serveur multimédia, sur lequel Quick Connect doit être activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr non ha fatto accedere questo account. Deve essere collegato allo stesso server multimediale, con Quick Connect attivo lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerrがこのアカウントでのサインインを受け付けませんでした。Seerrが同じメディアサーバに接続されていて、そのサーバでQuick Connectがオンになっている必要があります。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seerr wilde dit account niet laten inloggen. Het moet met dezelfde mediaserver verbonden zijn, en Quick Connect moet daar aanstaan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
