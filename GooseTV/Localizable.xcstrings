          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O canal parou de chegar. Escolha-o de novo para tentar outra vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "频道信号中断。再次选择即可重试。"
          }
        }
      }
    },
    "The collection is deleted from your server. What's in it stays in your library." : {
      "comment" : "Asked before a collection is deleted",
      "localizations" : {
        "de" : {
          "stringUnit" : {
