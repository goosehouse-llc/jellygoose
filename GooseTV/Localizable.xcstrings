    "Plays a film, or the next episode of a show, in JellyGoose." : {
      "comment" : "Shortcuts: what Play a Film or Show does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt einen Film oder die nächste Folge einer Serie in JellyGoose ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce una película, o el siguiente episodio de una serie, en JellyGoose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lit un film, ou le prochain épisode d’une série, dans JellyGoose."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce un film, o il prossimo episodio di una serie, in JellyGoose."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JellyGooseで映画、または番組の次のエピソードを再生します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt een film, of de volgende aflevering van een serie, af in JellyGoose."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduz um filme, ou o próximo episódio de uma série, no JellyGoose."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 JellyGoose 中播放电影，或剧集的下一集。"
          }
        }
      }
    },
    "Plays a show's or film's theme song quietly on its page, where your server keeps one. Jellyfin's Theme Songs plugin finds them." : {
      "comment" : "Under the theme music setting",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt die Titelmusik einer Serie oder eines Films leise auf ihrer Seite, wo dein Server eine hat. Das Jellyfin-Plugin Theme Songs findet sie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reproduce en voz baja la música de una serie o película en su página, donde tu servidor la tenga. El complemento Theme Songs de Jellyfin las encuentra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joue doucement la musique d’une série ou d’un film sur sa page, là où votre serveur en a une. Le plug-in Theme Songs de Jellyfin les trouve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riproduce a basso volume la sigla di una serie o di un film nella sua pagina, dove il tuo server ne ha una. Il plugin Theme Songs di Jellyfin le trova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーにテーマ曲がある番組や映画では、そのページで小さく流します。JellyfinのTheme Songsプラグインで見つけられます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speelt de titelmuziek van een serie of film zachtjes af op de pagina, waar je server er een heeft. De Jellyfin-plug-in Theme Songs vindt ze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca baixinho a música tema de uma série ou filme na página dele, onde seu servidor tiver uma. O plugin Theme Songs do Jellyfin as encontra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在服务器存有主题曲的剧集或电影页面上轻声播放主题曲。Jellyfin 的 Theme Songs 插件可以找到它们。"
          }
        }
      }
    },
    "Plays all your music in JellyGoose in no order." : {
      "comment" : "Shortcuts: what Shuffle My Music does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt deine ganze Musik in JellyGoose in zufälliger Reihenfolge ab."
          }
