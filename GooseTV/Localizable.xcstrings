    "The recording can't be watched from its start just yet. Try again in a minute." : {
      "comment" : "Live TV: the server has only just begun recording the programme, or has just finished, and its recording can't be read",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Aufnahme lässt sich noch nicht von Anfang an ansehen. Versuche es in einer Minute noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La grabación aún no se puede ver desde el principio. Vuelve a intentarlo en un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’enregistrement ne peut pas encore être regardé depuis le début. Réessayez dans une minute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La registrazione non si può ancora guardare dall’inizio. Riprova tra un minuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この録画はまだ最初から見ることができません。1分後にもう一度お試しください。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De opname kan nog niet vanaf het begin worden bekeken. Probeer het over een minuut opnieuw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não é possível assistir à gravação desde o início. Tente de novo em um minuto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂时还无法从头观看这段录制。请一分钟后再试。"
          }
        }
      }
    },
    "The recording is deleted from your server and can't be brought back." : {
