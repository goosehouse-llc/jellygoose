    "Each device keeps its own colour scheme, quality, players, downloads, Live TV switches, Dialogue Boost, and who's signed in." : {
      "comment" : "Settings, iCloud Sync: what is not shared",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Gerät behält sein eigenes Farbschema, seine Qualität, Player, Downloads, Live-TV-Schalter, Dialogverstärkung und wer angemeldet ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada dispositivo conserva su propio esquema de colores, calidad, reproductores, descargas, interruptores de TV en directo, realce de diálogos y quién ha iniciado sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque appareil garde son propre thème de couleurs, sa qualité, ses lecteurs, ses téléchargements, ses réglages de TV en direct, Dialogues renforcés et la personne connectée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni dispositivo mantiene il proprio schema di colori, la qualità, i lettori, i download, gli interruttori della TV in diretta, Dialoghi in risalto e chi ha effettuato l’accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カラースキーム、画質、プレーヤー、ダウンロード、ライブTVのスイッチ、セリフ強調、サインインしている人は、デバイスごとに保持されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk apparaat houdt zijn eigen kleurenschema, kwaliteit, spelers, downloads, live-tv-schakelaars, dialoogversterking en wie er is ingelogd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada dispositivo mantém seu próprio esquema de cores, qualidade, players, downloads, chaves de TV ao vivo, realce de diálogos e quem está conectado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配色方案、画质、播放器、下载、电视直播开关、对白增强以及登录的人，由每台设备各自保留。"
          }
        }
      }
    },
