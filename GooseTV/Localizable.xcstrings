    "Up and down move it. Select puts it there; Back puts it back." : {
      "comment" : "Apple TV, moving a song along a playlist: how",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoch und Runter verschieben ihn. Auswählen legt ihn dort ab, Zurück stellt ihn zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arriba y abajo la mueven. Seleccionar la deja ahí; Atrás la devuelve a su sitio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haut et bas le déplacent. Sélectionner le dépose ici ; Retour le remet en place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su e giù lo spostano. Seleziona lo lascia lì; Indietro lo rimette a posto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上下で移動します。選択でその位置に置き、戻るで元に戻します。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omhoog en omlaag verplaatsen het. Selecteer zet het daar neer; Terug zet het terug."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cima e para baixo movem a música. Selecionar a deixa ali; Voltar a devolve ao lugar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按上下键移动。按选择键放在此处；按返回键放回原处。"
          }
        }
      }
    },
    "Up and down to move it, then press Select" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit oben und unten verschieben, dann Auswählen drücken"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arriba y abajo para moverlo; después pulsa Seleccionar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
