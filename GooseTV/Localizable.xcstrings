    "Downloads wait for Wi-Fi instead of using mobile data. A change applies to downloads started after it." : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads warten auf WLAN, statt mobile Daten zu nutzen. Eine Änderung gilt für Downloads, die danach starten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las descargas esperan al wifi en lugar de usar datos móviles. Un cambio se aplica a las descargas que empiecen después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les téléchargements attendent le Wi-Fi au lieu d’utiliser les données cellulaires. Un changement s’applique aux téléchargements lancés ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I download aspettano il Wi-Fi invece di usare i dati cellulari. Una modifica vale per i download avviati dopo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードはモバイルデータ通信を使わず、Wi-Fiを待ちます。変更は、その後に始めたダウンロードに適用されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads wachten op wifi in plaats van mobiele data te gebruiken. Een wijziging geldt voor downloads die daarna starten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os downloads esperam pelo Wi-Fi em vez de usar dados móveis. Uma mudança vale para downloads iniciados depois dela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载会等待无线局域网，而不使用蜂窝数据。更改仅适用于之后开始的下载。"
          }
        }
      }
    },
