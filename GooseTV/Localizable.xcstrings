    },
    "A panel in the player shows which player has the film, and whether your server is converting it." : {
      "comment" : "What's New: the playback stats panel",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Feld im Player zeigt, welcher Player den Film abspielt und ob dein Server ihn umwandelt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un panel en el reproductor muestra qué reproductor tiene la película y si tu servidor la está convirtiendo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un panneau dans le lecteur indique quel lecteur joue le film et si votre serveur le convertit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un pannello nel lettore mostra quale lettore sta riproducendo il film e se il tuo server lo sta convertendo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プレーヤーのパネルで、どのプレーヤーが再生しているか、サーバーが変換しているかを確認できます。"
          }
        },
        "nl" : {
