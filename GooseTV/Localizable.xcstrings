      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nimm eine Sendung oder eine ganze Serie direkt aus dem Programmführer auf. Was ansteht, findest du unter „Geplant“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programa la grabación de una emisión o de una serie entera desde la guía, y mira lo que viene en Programadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Programmez l’enregistrement d’une diffusion ou d’une série entière depuis le guide, et retrouvez ce qui est prévu dans Programmés."
