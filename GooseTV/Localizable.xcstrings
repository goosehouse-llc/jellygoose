    "Ask for films and shows your server doesn't have yet, through Seerr. You're signed in there with your %@ account, with no password to type." : {
      "comment" : "The placeholder is the server software's name, Jellyfin or Emby",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frage über Seerr Filme und Serien an, die dein Server noch nicht hat. Du wirst dort mit deinem %@-Konto angemeldet, ohne ein Passwort einzugeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicita mediante Seerr películas y series que tu servidor aún no tiene. Inicias sesión allí con tu cuenta de %@, sin escribir ninguna contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez via Seerr les films et séries que votre serveur n’a pas encore. Vous y êtes connecté avec votre compte %@, sans mot de passe à saisir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richiedi tramite Seerr i film e le serie che il tuo server non ha ancora. Accedi lì con il tuo account %@, senza digitare la password."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバにまだない映画や番組を、Seerrを通じてリクエストできます。Seerrには%@アカウントでサインインするので、パスワードの入力は不要です。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraag via Seerr films en series aan die je server nog niet heeft. Je logt daar in met je %@-account, zonder een wachtwoord te typen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça pelo Seerr filmes e séries que o seu servidor ainda não tem. Você entra lá com a sua conta do %@, sem digitar senha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 Seerr 请求服务器上还没有的电影和剧集。你将使用 %@ 账户在那里登录，无需输入密码。"
          }
        }
      }
    },
