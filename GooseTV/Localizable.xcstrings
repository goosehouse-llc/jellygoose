    "It shows over what they're watching for ten seconds." : {
      "comment" : "Settings, Dashboard: what sending a message does",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wird zehn Sekunden lang über dem angezeigt, was gerade läuft."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece sobre lo que están viendo durante diez segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’affiche par-dessus ce qu’ils regardent pendant dix secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appare sopra ciò che stanno guardando per dieci secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "視聴中の画面に10秒間表示されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het verschijnt tien seconden lang over wat ze kijken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aparece sobre o que a pessoa está assistindo por dez segundos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "会在对方正在观看的内容上显示十秒钟。"
          }
        }
      }
    },
    "It stops as if they'd stopped it themselves, where they got to kept." : {
      "comment" : "Settings, Dashboard: what stopping someone's playback means",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es stoppt, als hätten sie es selbst beendet; ihre Position bleibt erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detiene como si lo hubieran detenido ellos, y se guarda por dónde iban."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La lecture s’arrête comme s’ils l’avaient arrêtée eux-mêmes, et leur position est conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si interrompe come se l’avessero fermata loro, e il punto raggiunto viene salvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本人が停止した場合と同じように停止し、再生位置は保存されます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het stopt alsof ze het zelf stopten; waar ze waren blijft bewaard."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para como se a pessoa tivesse parado, e o ponto em que estava é guardado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "就像对方自己停止一样，并会保留播放位置。"
          }
        }
      }
    },
    "JellyGoose for Mac: your library in a window of its own, with downloads, Live TV and music. Your unlock covers it." : {
      "comment" : "What's New: the Mac app",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JellyGoose für den Mac: deine Mediathek in einem eigenen Fenster, mit Downloads, Live-TV und Musik. Deine Freischaltung gilt auch dort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JellyGoose para Mac: tu biblioteca en una ventana propia, con descargas, TV en directo y música. Tu desbloqueo también vale allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JellyGoose pour Mac : votre bibliothèque dans sa propre fenêtre, avec les téléchargements, la TV en direct et la musique. Votre déblocage le couvre aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JellyGoose per Mac: la tua libreria in una finestra tutta sua, con download, TV in diretta e musica. Il tuo sblocco vale anche lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac版JellyGoose：ダウンロード、ライブTV、音楽も使える専用ウインドウでライブラリを。購入済みのロック解除がそのまま使えます。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JellyGoose voor Mac: je bibliotheek in een eigen venster, met downloads, live-tv en muziek. Je ontgrendeling geldt er ook."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JellyGoose para Mac: sua biblioteca em uma janela própria, com downloads, TV ao vivo e música. Seu desbloqueio vale lá também."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JellyGoose Mac 版：在独立窗口中浏览你的媒体库，支持下载、电视直播和音乐。你的解锁同样适用。"
          }
        }
      }
    },
