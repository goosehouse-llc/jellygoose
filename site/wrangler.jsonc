{
  // The jellygoose.app site: static files only, no server code.
  "name": "jellygoose-site",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  // Both names serve the same assets. (Workers assets _redirects only takes
  // relative paths, so a www-to-apex redirect would need a zone rule.)
  "routes": [
    { "pattern": "jellygoose.app", "custom_domain": true },
    { "pattern": "www.jellygoose.app", "custom_domain": true }
  ]
}
