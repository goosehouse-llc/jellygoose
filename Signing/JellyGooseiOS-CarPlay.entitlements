<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The simulator's copy of the iPhone app's entitlements, kept the same
	     as the device's: CarPlay audio alone (see JellyGooseiOS.entitlements). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.goosehouse.jellygoose</string>
	</array>
	<key>com.apple.developer.carplay-audio</key>
	<true/>
	<!-- Settings shared between the viewer's devices (SettingsSync): one
	     store for the iPhone, iPad and Apple TV apps alike. -->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)com.goosehouse.jellygoose</string>
</dict>
</plist>
